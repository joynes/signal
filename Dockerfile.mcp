FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
COPY packages packages
RUN npm ci --workspace=@signal-app/core --workspace=@signal-app/mcp --include-workspace-root

COPY electron/assets/soundfonts/A320U.sf2 electron/assets/soundfonts/A320U.sf2
RUN npm run build --workspace=@signal-app/mcp

FROM node:22-bookworm-slim

ENV MCP_TRANSPORT=http \
    HOST=0.0.0.0 \
    PORT=3000 \
    SIGNAL_ARTIFACT_DIR=/data/artifacts

WORKDIR /app
COPY --from=build /app/packages/mcp/dist/server.mjs packages/mcp/dist/server.mjs
COPY --from=build /app/electron/assets/soundfonts/A320U.sf2 electron/assets/soundfonts/A320U.sf2
RUN mkdir -p /data/artifacts && chown -R node:node /app /data

USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "packages/mcp/dist/server.mjs"]
